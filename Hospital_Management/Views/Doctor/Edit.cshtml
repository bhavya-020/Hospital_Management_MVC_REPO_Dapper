@model Hospital_Management.Models.DoctorModel

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Edit Doctor</h4>
                </div>

                <div class="card-body">
                    @using (Html.BeginForm())
                    {
                        @Html.HiddenFor(x => x.DoctorId)

                        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                        <!-- Doctor Name -->
                        <div class="mb-3">
                            <label class="form-label">Doctor Name</label>
                            @Html.TextBoxFor(x => x.DoctorName, new
                            {
                                @class = "form-control",
                                                placeholder = "Enter doctor name",
                                                onkeypress = "return allowOnlyAlphabets(event)",
                                                onpaste = "return false",
                                                autocomplete = "off"
                                                })
                        @Html.ValidationMessageFor(x => x.DoctorName, "", new { @class = "text-danger" })
                    </div>

                    <!-- Specialization -->
                    <div class="mb-3">
                        <label class="form-label">Specialization</label>
                        @Html.DropDownListFor(
                                                m => m.Specialization,
                                                new SelectList(new[]
                                                {
                                                "Cardiologist",
                                                "Dermatologist",
                                                "Neurologist",
                                                "Orthopedic",
                                                "Other"
                                                }, Model.Specialization),
                                                "-- Select Specialization --",
                                                new { @class = "form-select", id = "specializationDropdown" }
                                                )
                    </div>

                    <!-- Other Specialization -->
                    <div class="mb-3" id="otherSpecDiv" style="display:none;">
                        <label class="form-label">Enter Specialization</label>
                        <input type="text"
                               id="otherSpecialization"
                               class="form-control"
                               value="@Model.Specialization"
                               placeholder="Enter specialization"
                               onkeypress="return allowOnlyAlphabets(event)"
                               onpaste="return false"
                               autocomplete="off" />
                    </div>

                    <!-- Workplace -->
                    <div class="mb-3">
                        <label class="form-label">Workplace</label>
                        @Html.TextBoxFor(x => x.WorkPlace, new
                                                {
                                @class = "form-control",
                                                placeholder = "Enter workplace",
                                                onkeypress = "return allowOnlyAlphabets(event)",
                                                onpaste = "return false",
                                                autocomplete = "off"
                                                })
                        @Html.ValidationMessageFor(x => x.WorkPlace, "", new { @class = "text-danger" })
                    </div>

                    <!-- Experience -->
                    <div class="mb-4">
                        <label class="form-label">Experience (Years)</label>
                        @Html.TextBoxFor(x => x.Experience, new
                                                {
                                @class = "form-control",
                                                placeholder = "Experience in years",
                                                inputmode = "numeric",
                                                onkeypress = "return isNumberKey(event)"
                                                })
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            Update Doctor
                        </button>
                    </div>
                                        }
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    function isNumberKey(evt) {
        var charCode = evt.which ? evt.which : evt.keyCode;
        return charCode >= 48 && charCode <= 57;
    }

    function allowOnlyAlphabets(evt) {
        var charCode = evt.which ? evt.which : evt.keyCode;
        return (
            (charCode >= 65 && charCode <= 90) ||
            (charCode >= 97 && charCode <= 122) ||
            charCode === 32
        );
    }

    document.addEventListener("DOMContentLoaded", function () {
        var dropdown = document.getElementById("specializationDropdown");
        var otherDiv = document.getElementById("otherSpecDiv");
        var otherInput = document.getElementById("otherSpecialization");

        // Edit mode load
        if (!["Cardiologist", "Dermatologist", "Neurologist", "Orthopedic", "Other"]
            .includes(dropdown.value)) {
            dropdown.value = "Other";
            otherDiv.style.display = "block";
            dropdown.name = "";
            otherInput.name = "Specialization";
        }

        dropdown.addEventListener("change", function () {
            if (this.value === "Other") {
                otherDiv.style.display = "block";
                dropdown.name = "";
                otherInput.name = "Specialization";
            } else {
                otherDiv.style.display = "none";
                dropdown.name = "Specialization";
                otherInput.name = "";
                otherInput.value = "";
            }
        });
    });
</script>
