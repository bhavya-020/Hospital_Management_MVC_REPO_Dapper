@{
}


@model IEnumerable<DoctorModel>

    @if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}


<h2>Doctor List</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Doctor</a>
</p>


<form method="get" class="row mb-3">
    <div class="col-md-4">
        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control"
               placeholder="Search doctor, specialization, workplace" />
    </div>

    <div class="col-md-2">
        <button class="btn btn-primary w-100">Search</button>
    </div>

    <div class="col-md-2">
        <a asp-action="Index" class="btn btn-secondary w-100">Clear</a>
    </div>
</form>


<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Doctor Name</th>
            <th>Specialization</th>
            <th>Work Place</th>
            <th>Experience</th>
            <th>Actions</th>
            <th>Created On</th>
        </tr>
    </thead>
    <tbody>
        @{
            int count = 1 + ((ViewBag.CurrentPage - 1) * 10);
        }
        @foreach (var d in Model)
        {
            <tr>
                <td>@d.DoctorName</td>
                <td>@d.Specialization</td>
                <td>@d.WorkPlace</td>
                <td>@d.Experience</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@d.DoctorId" class="btn btn-warning btn-sm">
                        Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@d.DoctorId"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Are you sure?');">
                        Delete
                    </a>
                </td>
                @* <td>@d.CreatedOn.ToString(@"hh\:mm")</td> *@
                <td>@d.CreatedOn.ToString("dd-MM-yyyy hh:mm tt")</td>

            </tr>
            count++;
        }
    </tbody>
</table>


<nav>
    <ul class="pagination justify-content-center">
        @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
        {
            <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                <a class="page-link"
                   href="?page=@i&search=@ViewBag.Search">
                    @i
                </a>
            </li>
        }
    </ul>
</nav>
