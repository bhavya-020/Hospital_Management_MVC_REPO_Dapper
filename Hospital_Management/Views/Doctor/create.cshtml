@model Hospital_Management.Models.DoctorModel

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Add Doctor</h4>
                </div>

                <div class="card-body">

                    @using (Html.BeginForm())
                    {
                        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                        <div class="row">
                            <!-- Doctor Name -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label">
                                    Doctor Name <span class="text-danger">*</span>
                                </label>
                                @Html.TextBoxFor(x => x.DoctorName, new {
                                @class = "form-control",
                                                        placeholder = "Enter doctor name",
                                                        onkeypress = "return allowOnlyAlphabets(event)",
                                                        onpaste = "return false",
                                                        autocomplete = "off"
                                                        })
                            @Html.ValidationMessageFor(x => x.DoctorName, "", new { @class = "text-danger" })
                        </div>

                        <!-- Workplace -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label">
                                Workplace <span class="text-danger">*</span>
                            </label>
                            @Html.TextBoxFor(x => x.WorkPlace, new {
                                                        @class = "form-control",
                                                        placeholder = "Hospital / Clinic name",
                                                        onkeypress = "return allowOnlyAlphabets(event)",
                                                        onpaste = "return false",
                                                        autocomplete = "off"
                                                        })
                            @Html.ValidationMessageFor(x => x.WorkPlace, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <!-- Specialization -->
                    <div class="mb-3">
                        <label class="form-label">
                            Specialization <span class="text-danger">*</span>
                        </label>

                        @Html.DropDownListFor(
                                                m => m.Specialization,
                                                new SelectList(new[]
                                                {
                                                "-- Select Specialization --",
                                                "Cardiologist",
                                                "Dermatologist",
                                                "Neurologist",
                                                "Orthopedic",
                                                "Other"
                                                }),
                                                new { @class = "form-select", id = "specializationDropdown" }
                                                )
                    </div>

                    <!-- Other Specialization -->
                    <div class="mb-3" id="otherSpecDiv" style="display:none;">
                        <label class="form-label">
                            Enter Specialization <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               id="otherSpecialization"
                               class="form-control"
                               placeholder="Enter specialization"
                               onkeypress="return allowOnlyAlphabets(event)"
                               onpaste="return false"
                               autocomplete="off" />
                    </div>

                    <div class="row">
                        <!-- Experience -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label">
                                Experience (Years) <span class="text-danger">*</span>
                            </label>
                            @Html.TextBoxFor(x => x.Experience, new {
                                                        @class = "form-control",
                                                        placeholder = "e.g. 5",
                                                        inputmode = "numeric",
                                                        pattern = "[0-9]*",
                                                        onkeypress = "return isNumberKey(event)"
                                                        })
                            @Html.ValidationMessageFor(x => x.Experience, "", new { @class = "text-danger" })
                        </div>
                    </div>


                    @* <div class="form-group">
                        <label class="form-label">Time</label>
                        @Html.TextBoxFor(x => x.CreatedTime, new {
                                                @class = "form-control",
                                                type = "time"
                                                })
                        @Html.ValidationMessageFor(x => x.CreatedTime, "", new { @class = "text-danger" })
                    </div> *@


                    <hr />

                    <!-- Buttons -->
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-success px-4">
                            Save Doctor
                        </button>
                    </div>
                                        }
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    function isNumberKey(evt) {
        var charCode = evt.which ? evt.which : evt.keyCode;
        return charCode >= 48 && charCode <= 57;
    }

    function allowOnlyAlphabets(evt) {
        var charCode = evt.which ? evt.which : evt.keyCode;
        return (
            (charCode >= 65 && charCode <= 90) ||
            (charCode >= 97 && charCode <= 122) ||
            charCode === 32
        );
    }

    document.addEventListener("DOMContentLoaded", function () {

        var dropdown = document.getElementById("specializationDropdown");
        var otherDiv = document.getElementById("otherSpecDiv");
        var otherInput = document.getElementById("otherSpecialization");

        dropdown.addEventListener("change", function () {

            if (this.value === "Other") {
                otherDiv.style.display = "block";
                dropdown.name = "";
                otherInput.name = "Specialization";
            } else {
                otherDiv.style.display = "none";
                dropdown.name = "Specialization";
                otherInput.name = "";
                otherInput.value = "";
            }
        });
    });
</script>






