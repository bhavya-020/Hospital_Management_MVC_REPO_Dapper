    <div class="form-group">
        @Html.TextBoxFor(x => x.DoctorName, new { @class = "form-control", placeholder = "Doctor Name" ,onkeypress = "return allowOnlyAlphabets(event)",
        onpaste = "return false",
        autocomplete = "off"})
        @Html.ValidationMessageFor(x => x.DoctorName, "", new { @class = "text-danger" })
    </div>

