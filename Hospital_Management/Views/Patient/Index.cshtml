@{
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}



@model IEnumerable<Hospital_Management.Models.PatientModel>

<h2>Patient List</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Patient</a>
</p>

<form method="get" class="row mb-3">
    <div class="col-md-4">
        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control"
               placeholder="Search patient name or phone" />
    </div>

    <div class="col-md-2">
        <button class="btn btn-primary w-100">Search</button>
    </div>

    <div class="col-md-2">
        <a asp-action="Index" class="btn btn-secondary w-100">Clear</a>
    </div>
</form>


<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Patient Name</th>
            <th>Age</th>
            <th>Gender</th>
            <th>Contact</th>
            <th>Time</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.PatientName</td>
                <td>@p.Age</td>
                <td>@p.Gender</td>
                <td>@p.Contact</td>
                @* <td>@p.CreatedTime.ToString(@"hh\:mm")</td> *@

                <td>@p.CreatedOn.ToString("dd-MM-yyyy hh:mm tt")</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@p.PatientId" class="btn btn-warning btn-sm">
                        Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@p.PatientId"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Are you sure?');">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
